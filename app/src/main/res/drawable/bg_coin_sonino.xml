<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <!-- Gradiente para dar efeito 3D de metal -->
    <gradient
        android:angle="45"
        android:startColor="#FFD700"
        android:centerColor="#D4AF37"
        android:endColor="#B8860B"
        android:type="linear" />
    <!-- Borda interna brilhante -->
    <stroke android:width="1.5dp" android:color="#FFF8DC" />
    <!-- Padding para o texto não colar na borda -->
    <padding android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp" />
</shape>
