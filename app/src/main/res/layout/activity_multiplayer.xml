<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_mesa"
    android:padding="24dp">

    <Button
        android:id="@+id/btnVoltarMulti"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_escuro"
        android:text="⬅"
        android:textColor="@color/dourado"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTituloMulti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jogar Online"
        android:textColor="@color/dourado"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltarMulti" />

    <!-- Secção Criar Sala -->
    <Button
        android:id="@+id/btnCriarSala"
        android:layout_width="300dp"
        android:layout_height="65dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/btn_dourado"
        android:text="CRIAR SALA"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloMulti" />

    <TextView
        android:id="@+id/txtCodigoSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Código: --"
        android:textColor="@color/branco"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCriarSala" />

    <TextView
        android:id="@+id/txtStatusSala"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/dourado"
        android:textSize="16sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtCodigoSala" />

    <!-- Divisor -->
    <View
        android:id="@+id/divisor"
        android:layout_width="200dp"
        android:layout_height="2dp"
        android:layout_marginTop="32dp"
        android:background="@color/dourado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtStatusSala" />

    <!-- Secção Entrar na Sala -->
    <EditText
        android:id="@+id/edtCodigoEntrar"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/btn_escuro"
        android:hint="Código de 4 dígitos"
        android:inputType="number"
        android:maxLength="4"
        android:gravity="center"
        android:textColor="@color/branco"
        android:textColorHint="#AAAAAA"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divisor" />

    <Button
        android:id="@+id/btnEntrarSala"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_dourado"
        android:text="ENTRAR NA SALA"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtCodigoEntrar" />

</androidx.constraintlayout.widget.ConstraintLayout>
