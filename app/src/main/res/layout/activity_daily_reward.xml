<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/btn_escuro"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BÓNUS DIÁRIO"
        android:textColor="@color/dourado"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/txtDiaBonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dia 1 de 7"
        android:textColor="@color/branco"
        android:textSize="18sp" />

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/btn_star_big_on"
        android:tint="@color/dourado"
        android:layout_marginVertical="16dp"/>

    <TextView
        android:id="@+id/txtValorBonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪙 +50 Moedas"
        android:textColor="@color/dourado"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnReceberBonus"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:background="@drawable/btn_dourado"
        android:text="RECEBER"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
