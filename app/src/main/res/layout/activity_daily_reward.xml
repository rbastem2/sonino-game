<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/btn_escuro"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BÓNUS DIÁRIO"
        android:textColor="@color/dourado"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/txtStatusBonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volte todos os dias para ganhar mais!"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <!-- Calendário Horizontal -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutDias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnReceberBonus"
        android:layout_width="220dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_dourado"
        android:text="RESGATAR"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
