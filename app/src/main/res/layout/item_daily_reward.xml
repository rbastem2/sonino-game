<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardDia"
    android:layout_width="80dp"
    android:layout_height="110dp"
    android:layout_margin="4dp"
    android:background="@drawable/btn_escuro"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <TextView
        android:id="@+id/txtDiaSemana"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dia 1"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:textStyle="bold" />

    
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginVertical="4dp"
        android:elevation="4dp">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_coin_sonino" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="S"
            android:textColor="#0B3B24"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#FFF8DC"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1" />
    </FrameLayout>
    

    <TextView
        android:id="@+id/txtQtdMoedas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50"
        android:textColor="@color/dourado"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
