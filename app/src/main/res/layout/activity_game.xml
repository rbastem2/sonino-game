<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B5E30">

    <!-- Cartas do Android -->
    <LinearLayout
        android:id="@+id/areaAndroid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout android:layout_width="60dp" android:layout_height="90dp" android:layout_margin="4dp" android:background="#1A1A1A">
            <TextView android:id="@+id/cartaAndroid1" android:layout_width="match_parent" android:layout_height="match_parent" android:text="?" android:textColor="#FFFFFF" android:gravity="center" android:textSize="20sp"/>
        </FrameLayout>
        <FrameLayout android:layout_width="60dp" android:layout_height="90dp" android:layout_margin="4dp" android:background="#1A1A1A">
            <TextView android:id="@+id/cartaAndroid2" android:layout_width="match_parent" android:layout_height="match_parent" android:text="?" android:textColor="#FFFFFF" android:gravity="center" android:textSize="20sp"/>
        </FrameLayout>
        <FrameLayout android:layout_width="60dp" android:layout_height="90dp" android:layout_margin="4dp" android:background="#1A1A1A">
            <TextView android:id="@+id/cartaAndroid3" android:layout_width="match_parent" android:layout_height="match_parent" android:text="?" android:textColor="#FFFFFF" android:gravity="center" android:textSize="20sp"/>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txtTrunfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trunfo: --"
        android:textColor="#D4AF37"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/areaMesa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/areaAndroid" />

    <!-- Mesa Central -->
    <LinearLayout
        android:id="@+id/areaMesa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#1A000000"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/areaJogador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTrunfo">

        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="8dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgMesaJogador" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaMesaJogador" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="8dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgMesaAndroid" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaMesaAndroid" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Suas Cartas -->
    <LinearLayout
        android:id="@+id/areaJogador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout android:layout_width="70dp" android:layout_height="105dp" android:layout_margin="4dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgJogador1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador1" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>
        
        <FrameLayout android:layout_width="70dp" android:layout_height="105dp" android:layout_margin="4dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgJogador2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador2" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>

        <FrameLayout android:layout_width="70dp" android:layout_height="105dp" android:layout_margin="4dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgJogador3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador3" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
