<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_tabuleiro">

    <!-- Topo: Placar -->
    <LinearLayout
        android:id="@+id/topoPlacar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_escuro"
            android:padding="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/dourado" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jogador" android:textColor="@color/branco" android:textSize="10sp" />
                <TextView android:id="@+id/txtScoreJogador" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 pts" android:textColor="@color/dourado" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_escuro"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="8dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partidas" android:textColor="@color/branco" android:textSize="10sp"/>
            <TextView android:id="@+id/txtPartidas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 x 0" android:textColor="@color/branco" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_escuro"
            android:padding="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="6dp" android:gravity="end">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android" android:textColor="@color/branco" android:textSize="10sp" />
                <TextView android:id="@+id/txtScoreAndroid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 pts" android:textColor="@color/dourado" android:textSize="14sp" android:textStyle="bold"/>
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_manage" app:tint="@color/dourado" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:background="@drawable/btn_escuro"
        android:text="≡"
        android:textColor="@color/dourado"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topoPlacar" />

    <!-- Botão de Som (ImageButton para melhor compatibilidade) -->
    <ImageButton
        android:id="@+id/btnSom"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="8dp"
        android:background="@drawable/btn_escuro"
        android:src="@android:drawable/ic_lock_silent_mode_off"
        android:tint="@color/dourado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topoPlacar" />

    <!-- Cartas do Android -->
    <LinearLayout
        android:id="@+id/areaAndroid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="240dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topoPlacar">

        <ImageView android:id="@+id/cartaAndroid1" android:layout_width="60dp" android:layout_height="90dp" android:layout_margin="4dp" android:src="@drawable/verso_carta" android:scaleType="fitCenter"/>
        <ImageView android:id="@+id/cartaAndroid2" android:layout_width="60dp" android:layout_height="90dp" android:layout_margin="4dp" android:src="@drawable/verso_carta" android:scaleType="fitCenter"/>
        <ImageView android:id="@+id/cartaAndroid3" android:layout_width="60dp" android:layout_height="90dp" android:layout_margin="4dp" android:src="@drawable/verso_carta" android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- Monte e Trunfo (CORRIGIDO) -->
    <RelativeLayout
        android:id="@+id/areaMonte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/areaMesa"
        app:layout_constraintBottom_toBottomOf="@+id/areaMesa">

        <!-- Carta de Trunfo (Deitada, ao fundo) -->
        <!-- O FrameLayout agora tem o tamanho exato da imagem rotacionada -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp">
            
            <ImageView 
                android:id="@+id/imgTrunfoMesa" 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_gravity="center"
                android:rotation="90" 
                android:scaleType="fitCenter" 
                android:visibility="gone"/>
                
            <TextView 
                android:id="@+id/txtTrunfoMesa" 
                android:layout_width="match_parent" 
                android:layout_height="match_parent" 
                android:layout_gravity="center"
                android:rotation="90" 
                android:gravity="center" 
                android:textStyle="bold" 
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Monte de cartas (Por cima do trunfo) -->
        <ImageView
            android:id="@+id/imgMonte"
            android:layout_width="55dp"
            android:layout_height="80dp"
            android:src="@drawable/verso_carta"
            android:scaleType="fitCenter"/>
    </RelativeLayout>

    <!-- Mesa Central -->
    <LinearLayout
        android:id="@+id/areaMesa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/areaJogador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/areaMonte"
        app:layout_constraintTop_toBottomOf="@+id/areaAndroid"
        app:layout_constraintVertical_bias="0.65">

        <FrameLayout android:layout_width="85dp" android:layout_height="125dp" android:layout_margin="4dp" android:elevation="8dp">
            <ImageView android:id="@+id/imgMesaJogador" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
            <TextView android:id="@+id/cartaMesaJogador" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout android:layout_width="85dp" android:layout_height="125dp" android:layout_margin="4dp" android:elevation="8dp">
            <ImageView android:id="@+id/imgMesaAndroid" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
            <TextView android:id="@+id/cartaMesaAndroid" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Feedback de Fim de Jogo -->
    <TextView
        android:id="@+id/txtFeedbackRodada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_escuro"
        android:padding="24dp"
        android:maxWidth="300dp"
        android:gravity="center"
        android:textColor="@color/dourado"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:elevation="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Suas Cartas -->
    <LinearLayout
        android:id="@+id/areaJogador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="4dp" android:elevation="6dp">
            <ImageView android:id="@+id/imgJogador1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador1" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>
        
        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="4dp" android:elevation="6dp">
            <ImageView android:id="@+id/imgJogador2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador2" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>

        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="4dp" android:elevation="6dp">
            <ImageView android:id="@+id/imgJogador3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador3" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
