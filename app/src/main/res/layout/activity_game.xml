<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_mesa">

    <!-- Topo: Jogador vs Android -->
    <LinearLayout
        android:id="@+id/topoPlacar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Você: 0"
            android:textColor="@color/branco"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTrunfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Trunfo: --"
            android:textColor="@color/dourado"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 Android: 0"
            android:textColor="@color/branco"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cartas do Android -->
    <LinearLayout
        android:id="@+id/areaAndroid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topoPlacar">

        <FrameLayout android:layout_width="55dp" android:layout_height="85dp" android:layout_margin="4dp" android:background="@color/preto_fundo">
            <TextView android:id="@+id/cartaAndroid1" android:layout_width="match_parent" android:layout_height="match_parent" android:text="🇬🇼" android:textColor="@color/dourado" android:gravity="center" android:textSize="20sp"/>
        </FrameLayout>
        <FrameLayout android:layout_width="55dp" android:layout_height="85dp" android:layout_margin="4dp" android:background="@color/preto_fundo">
            <TextView android:id="@+id/cartaAndroid2" android:layout_width="match_parent" android:layout_height="match_parent" android:text="🇬🇼" android:textColor="@color/dourado" android:gravity="center" android:textSize="20sp"/>
        </FrameLayout>
        <FrameLayout android:layout_width="55dp" android:layout_height="85dp" android:layout_margin="4dp" android:background="@color/preto_fundo">
            <TextView android:id="@+id/cartaAndroid3" android:layout_width="match_parent" android:layout_height="match_parent" android:text="🇬🇼" android:textColor="@color/dourado" android:gravity="center" android:textSize="20sp"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Mesa Central -->
    <LinearLayout
        android:id="@+id/areaMesa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#33000000"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/areaJogador"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/areaAndroid">

        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="8dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgMesaJogador" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaMesaJogador" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout android:layout_width="80dp" android:layout_height="120dp" android:layout_margin="8dp" android:background="#FFFFFF">
            <ImageView android:id="@+id/imgMesaAndroid" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaMesaAndroid" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Suas Cartas -->
    <LinearLayout
        android:id="@+id/areaJogador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout android:layout_width="75dp" android:layout_height="110dp" android:layout_margin="4dp" android:background="#FFFFFF" android:elevation="4dp">
            <ImageView android:id="@+id/imgJogador1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador1" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>
        
        <FrameLayout android:layout_width="75dp" android:layout_height="110dp" android:layout_margin="4dp" android:background="#FFFFFF" android:elevation="4dp">
            <ImageView android:id="@+id/imgJogador2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador2" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>

        <FrameLayout android:layout_width="75dp" android:layout_height="110dp" android:layout_margin="4dp" android:background="#FFFFFF" android:elevation="4dp">
            <ImageView android:id="@+id/imgJogador3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone"/>
            <TextView android:id="@+id/cartaJogador3" android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="#000000" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
