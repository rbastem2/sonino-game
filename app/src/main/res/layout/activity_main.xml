<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_home"
    android:paddingTop="32dp"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.65" />

    <!-- Área dos botões centrais (Presente + Jogar) -->
    <LinearLayout
        android:id="@+id/linearBotoesCentrais"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnJogarOnline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline">

        <!-- Botão de Bónus Diário (Presente) -->
        <TextView
            android:id="@+id/btnBonusDiario"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_dourado"
            android:text="🎁"
            android:textSize="30sp"
            android:gravity="center"
            android:elevation="8dp" />

        <!-- Botão Jogar -->
        <Button
            android:id="@+id/btnJogar"
            android:layout_width="220dp"
            android:layout_height="65dp"
            android:background="@drawable/btn_dourado"
            android:text="JOGAR"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botão Jogar Online -->
    <Button
        android:id="@+id/btnJogarOnline"
        android:layout_width="292dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_escuro"
        android:text="JOGAR ONLINE"
        android:textColor="@color/dourado"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/linearBotoesMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearBotoesCentrais" />

    <!-- Botões inferiores -->
    <LinearLayout
        android:id="@+id/linearBotoesMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnRegras"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/btn_escuro"
            android:text="REGRAS"
            android:textColor="@color/dourado"
            android:textSize="10sp"
            android:padding="0dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfig"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/btn_escuro"
            android:text="NÍVEL"
            android:textColor="@color/dourado"
            android:textSize="10sp"
            android:padding="0dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHistorico"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_escuro"
            android:text="STATS"
            android:textColor="@color/dourado"
            android:textSize="10sp"
            android:padding="0dp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
